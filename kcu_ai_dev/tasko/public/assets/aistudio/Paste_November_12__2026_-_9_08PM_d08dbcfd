    <!-- [Figma Handoff] 4. 최하단 고정 영역: 우측 하단 에메랄드 그린 FAB 버튼 (Safe Area pb-8 대응) -->
    <div class="absolute bottom-6 right-5 z-20">
      <!-- FAB (Floating Action Button): 56x56px 에메랄드 그린 원형 (#1EA65C), shadow-fab, active:scale-95 -->
      <button type="button" onclick="openBottomSheet()" aria-label="새로운 태스크 추가" class="w-14 h-14 rounded-full bg-primary hover:bg-primary-hover active:scale-95 text-white flex items-center justify-center shadow-fab transition-all duration-200">
        <!-- SVG Plus 아이콘 (24x24 규격) -->
