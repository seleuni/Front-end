<!-- Tasko 모바일 할 일 상세/수정 화면 (iPhone 16) -->
<!DOCTYPE html>

<html lang="ko"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Tasko 모바일 할 일 상세/수정 화면 (iPhone 16)</title>
<!-- Tailwind CSS v3 CDN with forms plugin -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<!-- Pretendard Font -->
<link as="style" crossorigin="" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" rel="stylesheet"/>
<!-- Tailwind Configuration -->
<script data-purpose="tailwind-config">
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Pretendard', '-apple-system', 'BlinkMacSystemFont', 'system-ui', 'Roboto', 'sans-serif'],
          },
          colors: {
            tasko: {
              primary: '#1EA65C',
              'primary-hover': '#178449',
              'primary-light': '#E8F7EE',
              bg: '#F8F9FA',
              surface: '#FFFFFF',
              border: '#E9ECEF',
              text: '#212529',
              secondary: '#495057',
              muted: '#868E96',
              destructive: '#FA5252',
              'destructive-light': '#FFF5F5',
              'destructive-border': '#FFA8A8',
              yellow: '#FAB005'
            }
          }
        }
      }
    }
  </script>
<!-- Custom Core Styles -->
<style data-purpose="typography">
    body {
      font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
  </style>
<style data-purpose="device-frame">
    /* Subtle inner shadow for device depth matching snapshot environment */
    .iphone-frame-shadow {
      box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.08);
    }
    /* Hide scrollbars for slick native look */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>
<body class="bg-[#1A1E29] min-h-screen flex items-center justify-center p-4 sm:p-8">
<!-- BEGIN: PhoneContainer -->
<!-- iPhone 16 Frame Container matching other screen snapshots -->
<div class="w-[393px] min-h-[852px] h-[852px] bg-tasko-bg rounded-[48px] relative overflow-hidden flex flex-col iphone-frame-shadow border-[6px] border-[#2C3240] select-none" data-purpose="iphone-16-mockup" id="iphone-16-mockup">
<!-- BEGIN: DeviceStatusBar -->
<!-- Native iOS 16 Dynamic Island & Status Bar Header -->
<header class="w-full pt-3 px-7 flex justify-between items-center z-30 shrink-0 select-none">
<!-- Current Time -->
<span class="text-[14px] font-semibold tracking-tight text-tasko-text">9:41</span>
<!-- Dynamic Island Capsule -->
<div class="w-[96px] h-[26px] bg-black rounded-full flex items-center justify-end pr-2.5">
<div class="w-2.5 h-2.5 rounded-full bg-[#111] border border-[#222]"></div>
</div>
<!-- Status Icons: Cellular, WiFi, Battery -->
<div class="flex items-center space-x-1.5 text-tasko-text">
<!-- Cellular Signal Icon -->
<svg class="w-4 h-3 fill-current" viewbox="0 0 18 12">
<rect height="4" rx="0.5" width="3" x="0" y="8"></rect>
<rect height="7" rx="0.5" width="3" x="5" y="5"></rect>
<rect height="10" rx="0.5" width="3" x="10" y="2"></rect>
<rect height="12" rx="0.5" width="3" x="15" y="0"></rect>
</svg>
<!-- WiFi Icon -->
<svg class="w-3.5 h-3 fill-current" viewbox="0 0 16 12">
<path d="M8 2.5C10.7 2.5 13.1 3.6 14.8 5.4L16 4.1C13.9 1.9 11.1 0.5 8 0.5C4.9 0.5 2.1 1.9 0 4.1L1.2 5.4C2.9 3.6 5.3 2.5 8 2.5ZM8 6.5C9.7 6.5 11.2 7.2 12.3 8.3L13.5 7.1C12.1 5.7 10.1 4.8 8 4.8C5.9 4.8 3.9 5.7 2.5 7.1L3.7 8.3C4.8 7.2 6.3 6.5 8 6.5ZM8 10C8.8 10 9.5 10.7 9.5 11.5C9.5 12.3 8.8 13 8 13C7.2 13 6.5 12.3 6.5 11.5C6.5 10.7 7.2 10 8 10Z"></path>
</svg>
<!-- Battery Icon -->
<svg class="w-6 h-3 fill-current" viewbox="0 0 24 12">
<rect fill="none" height="11" rx="3.5" stroke="currentColor" stroke-width="1" width="20" x="0.5" y="0.5"></rect>
<rect fill="currentColor" height="8" rx="2" width="14" x="2" y="2"></rect>
<path d="M22 4C22.6 4.5 23 5.2 23 6C23 6.8 22.6 7.5 22 8V4Z" fill="currentColor"></path>
</svg>
</div>
</header>
<!-- END: DeviceStatusBar -->
<!-- BEGIN: TopAppBar -->
<!-- Navigation Bar: Back button, Screen Title, Delete Button -->
<nav class="w-full px-5 py-3 flex items-center justify-between bg-tasko-bg z-20 shrink-0" data-purpose="top-app-bar">
<!-- Back Button -->
<button aria-label="뒤로 가기" class="w-10 h-10 -ml-2 flex items-center justify-center rounded-full hover:bg-gray-200/60 active:scale-95 transition-all text-tasko-text" type="button">
<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" viewbox="0 0 24 24">
<polyline points="15 18 9 12 15 6"></polyline>
</svg>
</button>
<!-- Center Title -->
<h1 class="text-[17px] font-bold text-tasko-text tracking-tight">할 일 상세</h1>
<!-- Delete Button (Destructive Color) -->
<button aria-label="할 일 삭제" class="w-10 h-10 -mr-2 flex items-center justify-center rounded-full hover:bg-red-50 active:scale-95 transition-all text-tasko-destructive" type="button">
<svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" viewbox="0 0 24 24">
<polyline points="3 6 5 6 21 6"></polyline>
<path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
<line x1="10" x2="10" y1="11" y2="17"></line>
<line x1="14" x2="14" y1="11" y2="17"></line>
</svg>
</button>
</nav>
<!-- END: TopAppBar -->
<!-- BEGIN: MainContent -->
<!-- Scrollable content area containing forms and details -->
<main class="flex-1 overflow-y-auto px-5 pt-1 pb-4 no-scrollbar flex flex-col justify-between">
<!-- Top Section: Interactive form controls -->
<div class="space-y-4">
<!-- Completion Check Box Card -->
<!-- Allows toggling task completion state directly inside details -->
<section class="bg-tasko-surface rounded-2xl p-4 border border-tasko-border flex items-center justify-between shadow-[0_1px_2px_rgba(0,0,0,0.03)] cursor-pointer hover:border-gray-300 transition-colors" data-purpose="completion-toggle-card">
<div class="flex items-center gap-3">
<!-- Unchecked circular status indicator -->
<div class="w-[22px] h-[22px] rounded-full border-2 border-tasko-border bg-tasko-surface flex items-center justify-center transition-all">
<span class="sr-only">완료 미체크</span>
</div>
<span class="text-[15px] font-medium text-tasko-text">완료로 표시</span>
</div>
<span class="text-[12px] font-medium text-tasko-muted bg-gray-100 px-2 py-0.5 rounded-md">진행 중</span>
</section>
<!-- Edit Form Section (Matching BottomSheet Structure from SCREEN_7) -->
<section class="bg-tasko-surface rounded-2xl p-4 border border-tasko-border shadow-[0_1px_2px_rgba(0,0,0,0.03)] space-y-4" data-purpose="edit-inputs-section">
<!-- Field 1: 할 일 제목 (Task Title) -->
<div class="space-y-1.5">
<label class="block text-[13px] font-semibold text-tasko-secondary" for="task-title-input">
              할 일 제목 <span class="text-tasko-destructive">*</span>
</label>
<input class="w-full h-12 px-3.5 rounded-xl border border-tasko-border bg-tasko-surface text-tasko-text font-medium text-[15px] placeholder-tasko-muted focus:border-tasko-primary focus:ring-1 focus:ring-tasko-primary focus:outline-none transition-colors" id="task-title-input" type="text" value="저녁 운동 30분"/>
</div>
<!-- Field 2: 우선순위 선택 (Priority Selection) -->
<div class="space-y-1.5">
<label class="block text-[13px] font-semibold text-tasko-secondary">
              우선순위
            </label>
<!-- 3-Segment priority buttons with '높음' selected -->
<div class="grid grid-cols-3 gap-2">
<!-- Option: 높음 (Selected - Red/Destructive Accent) -->
<button class="h-11 rounded-xl font-semibold text-[14px] flex items-center justify-center border border-tasko-destructive-border bg-tasko-destructive-light text-tasko-destructive shadow-sm" type="button">
<span class="w-1.5 h-1.5 rounded-full bg-tasko-destructive mr-1.5"></span>
                높음
              </button>
<!-- Option: 중간 (Unselected) -->
<button class="h-11 rounded-xl font-medium text-[14px] flex items-center justify-center border border-tasko-border bg-tasko-surface text-tasko-secondary hover:bg-gray-50 transition-colors" type="button">
<span class="w-1.5 h-1.5 rounded-full bg-amber-400 mr-1.5 opacity-60"></span>
                중간
              </button>
<!-- Option: 낮음 (Unselected) -->
<button class="h-11 rounded-xl font-medium text-[14px] flex items-center justify-center border border-tasko-border bg-tasko-surface text-tasko-secondary hover:bg-gray-50 transition-colors" type="button">
<span class="w-1.5 h-1.5 rounded-full bg-tasko-primary mr-1.5 opacity-60"></span>
                낮음
              </button>
</div>
</div>
<!-- Field 3: 카테고리 선택 (Category Dropdown) -->
<div class="space-y-1.5">
<label class="block text-[13px] font-semibold text-tasko-secondary" for="category-select">
              카테고리
            </label>
<div class="relative">
<select class="w-full h-12 px-3.5 pr-10 rounded-xl border border-tasko-border bg-tasko-surface text-tasko-text font-medium text-[15px] appearance-none focus:border-tasko-primary focus:ring-1 focus:ring-tasko-primary focus:outline-none transition-colors cursor-pointer" id="category-select">
<option selected="" value="health">#건강</option>
<option value="life">#생활</option>
<option value="study">#공부</option>
</select>
<!-- Dropdown Chevron Icon -->
<div class="absolute inset-y-0 right-0 flex items-center pr-3.5 pointer-events-none text-tasko-secondary">
<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24">
<polyline points="6 9 12 15 18 9"></polyline>
</svg>
</div>
</div>
</div>
<!-- Field 4: 마감일 선택 입력 (Due Date Input) -->
<div class="space-y-1.5">
<label class="block text-[13px] font-semibold text-tasko-secondary" for="due-date-input">
              마감일
            </label>
<div class="relative">
<input class="w-full h-12 px-3.5 pr-10 rounded-xl border border-tasko-border bg-tasko-surface text-tasko-text font-medium text-[15px] focus:border-tasko-primary focus:ring-1 focus:ring-tasko-primary focus:outline-none transition-colors" id="due-date-input" type="text" value="오늘 19:00"/>
<!-- Calendar / Clock Icon -->
<div class="absolute inset-y-0 right-0 flex items-center pr-3.5 pointer-events-none text-tasko-secondary">
<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24">
<rect height="18" rx="2" ry="2" width="18" x="3" y="4"></rect>
<line x1="16" x2="16" y1="2" y2="6"></line>
<line x1="8" x2="8" y1="2" y2="6"></line>
<line x1="3" x2="21" y1="10" y2="10"></line>
</svg>
</div>
</div>
</div>
<!-- Field 5: 중요 표시 (Star / Importance Toggle Row) -->
<div class="pt-1">
<div class="flex items-center justify-between p-3 rounded-xl bg-tasko-bg border border-tasko-border">
<div class="flex items-center gap-2.5">
<!-- Star Icon (Filled Gold/Yellow) -->
<div class="w-8 h-8 rounded-lg bg-amber-50 flex items-center justify-center shrink-0">
<svg class="w-5 h-5 text-tasko-yellow fill-current" viewbox="0 0 24 24">
<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
</svg>
</div>
<div>
<div class="text-[14px] font-semibold text-tasko-text">중요 할 일로 표시</div>
<div class="text-[11px] text-tasko-muted">목록 상단에 강조 표시됩니다</div>
</div>
</div>
<!-- Active iOS Toggle Switch with Primary #1EA65C -->
<label class="relative inline-flex items-center cursor-pointer select-none">
<input checked="" class="sr-only peer" type="checkbox"/>
<div class="w-11 h-6 bg-gray-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-tasko-primary"></div>
</label>
</div>
</div>
</section>
<!-- Creation Metadata Caption -->
<div class="text-center pt-0.5">
<span class="text-[12px] font-normal text-tasko-muted tracking-tight">2026.11.10 생성</span>
</div>
</div>
<!-- BEGIN: BottomActionArea -->
<!-- Bottom Save Action Button -->
<div class="pt-4 pb-1">
<button class="w-full h-[50px] bg-tasko-primary hover:bg-tasko-primary-hover active:scale-[0.99] text-white font-bold text-[16px] rounded-xl shadow-sm transition-all flex items-center justify-center" type="button">
          저장하기
        </button>
</div>
<!-- END: BottomActionArea -->
</main>
<!-- END: MainContent -->
<!-- BEGIN: HomeIndicator -->
<!-- Native iPhone 16 Home Indicator -->
<footer class="w-full pb-2 pt-1 flex justify-center shrink-0 z-30 select-none">
<div class="w-36 h-1 bg-tasko-text rounded-full opacity-80"></div>
</footer>
<!-- END: HomeIndicator -->
</div>
<!-- END: PhoneContainer -->
</body></html>

<!-- Tasko 모바일 전체 할 일 목록 화면 (iPhone 16) -->
<!DOCTYPE html><html lang="ko"><head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tasko 전체 할 일 목록 화면 (iPhone 16)</title>
  <!-- Pretendard Font -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css">
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Pretendard', '-apple-system', 'BlinkMacSystemFont', 'system-ui', 'Roboto', 'sans-serif'],
          },
          colors: {
            brand: {
              primary: '#1EA65C',
              primaryDark: '#178449',
              surfaceLight: '#E8F7EE',
              bg: '#F8F9FA',
              surface: '#FFFFFF',
              border: '#E9ECEF',
              textPrimary: '#212529',
              textSecondary: '#495057',
              textMuted: '#868E96',
              destructive: '#FA5252',
            }
          },
          boxShadow: {
            'fab': '0 4px 14px rgba(30, 166, 92, 0.35)',
            'card': '0 1px 3px rgba(0, 0, 0, 0.04)',
          }
        }
      }
    }
  </script>
  <style>
    body {
      font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: #0f172a;
      margin: 0;
      padding: 32px 16px;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* Hide scrollbar for clean horizontal swipe */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>
<body>

  <!-- iPhone 16 Frame Outer Container -->
  <div class="relative w-[393px] h-[852px] bg-[#F8F9FA] rounded-[52px] shadow-2xl border-[10px] border-[#1e293b] flex flex-col overflow-hidden text-[#212529]">
    
    <!-- iPhone 16 Dynamic Island & Status Bar Area -->
    <div class="relative w-full pt-3 px-7 pb-2 flex justify-between items-center z-30 select-none bg-[#F8F9FA]">
      <span class="text-[14px] font-semibold tracking-tight text-[#212529]">9:41</span>
      <!-- Dynamic Island Pill -->
      <div class="absolute left-1/2 -translate-x-1/2 top-2.5 w-[120px] h-[34px] bg-black rounded-full flex items-center justify-between px-3 pointer-events-none">
        <div class="w-2.5 h-2.5 rounded-full bg-[#111] border border-neutral-800"></div>
        <div class="w-3 h-3 rounded-full bg-[#0a0a14] border border-[#1a1a2e] flex items-center justify-center">
          <div class="w-1 h-1 rounded-full bg-[#1e293b]"></div>
        </div>
      </div>
      <!-- Right Status Icons (Cellular, Wifi, Battery) -->
      <div class="flex items-center gap-1.5 text-[#212529]">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61L4.35 18.25c-.2.2-.2.51 0 .71.2.2.51.2.71 0l.64-.64C7.23 19.34 9.48 20 12 20c4.97 0 9-4.03 9-9s-4.03-9-9-9zm0 15c-3.31 0-6-2.69-6-6s2.69-6 6-6 6 2.69 6 6-2.69 6-6 6z" opacity="0.3"></path>
          <path d="M12 6c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm0 10c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4z"></path>
        </svg>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 4C7.31 4 3.07 5.9 0 8.98L12 21 24 8.98A16.88 16.88 0 0 0 12 4z"></path>
        </svg>
        <div class="w-6 h-3 rounded-[4px] border border-[#212529] p-0.5 flex items-center">
          <div class="w-full h-full bg-[#212529] rounded-[2px]"></div>
        </div>
      </div>
    </div>

    <!-- 1. Sticky Top Header: Chevron-left (뒤로가기), "전체 할 일", Search icon -->
    <header class="sticky top-0 z-20 bg-[#F8F9FA]/95 backdrop-blur-md px-5 py-3 border-b border-[#E9ECEF] flex items-center justify-between select-none">
      <!-- Back button -->
      <button type="button" aria-label="대시보드로 돌아가기" class="w-10 h-10 -ml-2 rounded-xl flex items-center justify-center text-[#212529] hover:bg-[#E9ECEF]/70 active:scale-95 transition-all">
        <svg class="w-6 h-6 stroke-[#212529]" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>

      <!-- Center Title -->
      <h1 class="text-[18px] font-bold tracking-tight text-[#212529] text-center">전체 할 일</h1>

      <!-- Right Search icon -->
      <button type="button" aria-label="할 일 검색" class="w-10 h-10 -mr-2 rounded-xl flex items-center justify-center text-[#212529] hover:bg-[#E9ECEF]/70 active:scale-95 transition-all">
        <svg class="w-5 h-5 stroke-[#212529]" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="M21 21l-4.35-4.35"></path>
        </svg>
      </button>
    </header>

    <!-- 2. Dual Horizontal Filter Chips (가로 터치 스크롤) -->
    <div class="bg-[#F8F9FA] px-5 pt-3.5 pb-2.5 space-y-2.5 border-b border-[#E9ECEF]/60 select-none">
      <!-- 1줄: 상태 필터 (전체 8 / 진행 중 4 / 완료 4 / 중요 1) -->
      <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5">
        <!-- FilterChip Active: 전체 8 -->
        <button type="button" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-[#1EA65C] text-white shadow-sm shrink-0 active:scale-95 transition-all">
          <span>전체</span>
          <span class="w-4 h-4 rounded-full bg-white/25 text-[11px] flex items-center justify-center">8</span>
        </button>
        <!-- FilterChip Inactive: 진행 중 4 -->
        <button type="button" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-medium bg-[#FFFFFF] border border-[#E9ECEF] text-[#495057] hover:border-[#1EA65C] hover:text-[#1EA65C] shrink-0 active:scale-95 transition-all">
          <span>진행 중</span>
          <span class="text-[#868E96] text-[11px]">4</span>
        </button>
        <!-- FilterChip Inactive: 완료 4 -->
        <button type="button" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-medium bg-[#FFFFFF] border border-[#E9ECEF] text-[#495057] hover:border-[#1EA65C] hover:text-[#1EA65C] shrink-0 active:scale-95 transition-all">
          <span>완료</span>
          <span class="text-[#868E96] text-[11px]">4</span>
        </button>
        <!-- FilterChip Inactive: 중요 1 -->
        <button type="button" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-medium bg-[#FFFFFF] border border-[#E9ECEF] text-[#495057] hover:border-[#1EA65C] hover:text-[#1EA65C] shrink-0 active:scale-95 transition-all">
          <svg class="w-3.5 h-3.5 fill-[#FA5252] text-[#FA5252]" viewBox="0 0 24 24">
            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path>
          </svg>
          <span>중요</span>
