    <!-- [Figma Handoff] [2-2] 태스크 등록 바텀시트 (Bottom Sheet Modal & Backdrop) -->
    <div id="bottomSheetContainer" class="absolute inset-0 z-30 flex flex-col justify-end invisible">
      <!-- 반투명 딤드 배경 (터치 시 닫힘) -->
      <div id="bottomSheetBackdrop" onclick="closeBottomSheet()" class="absolute inset-0 bg-black/40 backdrop-blur-[2px] opacity-0"></div>

      <!-- 시트 패널 (translate-y-full -> translate-y-0 슬라이드 업) -->
      <div id="bottomSheetPanel" class="relative z-10 bg-surface rounded-t-[28px] p-5 pb-8 shadow-sheet flex flex-col border-t border-border translate-y-full">
        
        <!-- 상단 드래그 핸들 바 (Drag Handle Bar) -->
        <div class="w-12 h-1.5 bg-border rounded-full mx-auto mb-4 cursor-pointer" onclick="closeBottomSheet()"></div>

        <!-- 시트 헤더 -->
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-bold text-text-primary tracking-tight">새로운 할 일 등록</h2>
          <button type="button" onclick="closeBottomSheet()" class="w-8 h-8 rounded-full hover:bg-background text-text-muted flex items-center justify-center">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <!-- 바텀시트 입력 폼 본문 -->
        <form id="newTaskForm" onsubmit="handleCreateTask(event)" class="space-y-4">
          <!-- 1. 태스크 제목 인풋 -->
          <div>
            <label for="taskTitleInput" class="block text-xs font-semibold text-text-secondary mb-1.5">할 일 제목</label>
            <input type="text" id="taskTitleInput" required="" placeholder="무엇을 완료해야 하나요?" class="w-full px-3.5 py-2.5 rounded-xl bg-background border border-border text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all">
          </div>

          <!-- 2. 우선순위 선택 (우선순위 뱃지 토큰 재사용) -->
          <div>
            <label class="block text-xs font-semibold text-text-secondary mb-1.5">우선순위</label>
            <div class="grid grid-cols-3 gap-2">
              <label class="cursor-pointer">
                <input type="radio" name="priorityOption" value="high" class="peer sr-only">
                <div class="flex items-center justify-center gap-1.5 py-2 rounded-xl border border-border peer-checked:border-destructive peer-checked:bg-[#FA5252]/10 peer-checked:text-destructive text-text-secondary text-xs font-medium transition-all">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path>
                    <line x1="4" y1="22" x2="4" y2="15"></line>
                  </svg>
                  <span>높음</span>
                </div>
              </label>

              <label class="cursor-pointer">
                <input type="radio" name="priorityOption" value="medium" checked="" class="peer sr-only">
                <div class="flex items-center justify-center gap-1.5 py-2 rounded-xl border border-border peer-checked:border-text-secondary peer-checked:bg-background peer-checked:text-text-primary text-text-secondary text-xs font-medium transition-all">
                  <span class="w-2 h-2 rounded-full bg-text-secondary"></span>
                  <span>중간</span>
                </div>
              </label>

              <label class="cursor-pointer">
                <input type="radio" name="priorityOption" value="low" class="peer sr-only">
                <div class="flex items-center justify-center gap-1.5 py-2 rounded-xl border border-border peer-checked:border-primary peer-checked:bg-primary-light peer-checked:text-primary text-text-secondary text-xs font-medium transition-all">
                  <span class="w-2 h-2 rounded-full bg-primary"></span>
                  <span>낮음</span>
                </div>
              </label>
            </div>
          </div>

          <!-- 3. 태그 카테고리 & 마감일 -->
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="taskTagSelect" class="block text-xs font-semibold text-text-secondary mb-1.5">카테고리 태그</label>
              <select id="taskTagSelect" class="w-full px-3 py-2 rounded-xl bg-background border border-border text-xs text-text-primary focus:outline-none focus:border-primary"><option value="#생활" selected="">#생활</option>
<option value="#건강">#건강</option>
<option value="#공부">#공부</option>
<option value="#디자인">#디자인</option>
<option value="#개발">#개발</option>
<option value="#기획">#기획</option></select>
            </div>

            <div>
              <label for="taskDueDateInput" class="block text-xs font-semibold text-text-secondary mb-1.5">마감일</label>
              <div class="relative">
                <input type="text" id="taskDueDateInput" value="오늘 마감" class="w-full px-3 py-2 rounded-xl bg-background border border-border text-xs text-text-primary focus:outline-none focus:border-primary">
              </div>
            </div>
          </div>

          <!-- 하단: 에메랄드 그린 와이드 '할 일 추가하기' 버튼 -->
          <div class="pt-2">
            <button type="submit" class="w-full py-3.5 rounded-xl bg-primary hover:bg-primary-hover active:scale-[0.99] text-white font-semibold text-sm shadow-md transition-all flex items-center justify-center gap-2">
              <svg class="w-4 h-4 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span>할 일 추가하기</span>
            </button>
          </div>
        </form>

      </div>
    </div>

  </div>

  <!-- JavaScript: 상태 관리 및 실시간 인터랙션 연동 -->
  <script>
    // 초기 태스크 목업 데이터 (2단계 컴포넌트 명세 구조 준수)
    let tasks = [
      {
        id: 1,
        title: '피그마 디자인 시스템 토큰 싱크 맞추기',
        tag: '#디자인',
        dueDate: '오늘 18:00 마감',
        priority: 'high', // 'high' | 'medium' | 'low'
        completed: false,
        starred: true
      },
      {
        id: 2,
        title: 'React 컴포넌트 Props 인터페이스 명세서 검토',
        tag: '#개발',
        dueDate: '내일 마감',
        priority: 'medium',
        completed: false,
        starred: false
      },
      {
        id: 3,
        title: '모바일 13종 SVG UI 아이콘 뷰포트 규격 검증',
        tag: '#기획',
        dueDate: '완료됨 (어제)',
        priority: 'low',
        completed: true,
        starred: false
      },
      {
        id: 4,
        title: 'Tailwind CSS 팔레트 변수 10종 고정 세팅',
        tag: '#개발',
        dueDate: '완료됨',
        priority: 'medium',
        completed: true,
        starred: false
      },
      {
        id: 5,
        title: 'iPhone 16 웹 뷰포트 터치 타겟 최소 48px 확인',
        tag: '#디자인',
        dueDate: '완료됨',
        priority: 'high',
        completed: true,
        starred: false
      }
    ];

    let currentFilter = 'ALL'; // 'ALL' | 'IN_PROGRESS' | 'COMPLETED' | 'STARRED'

    // 1. 체크 토글 인터랙션 (카드 좌측 체크박스 터치 시 실시간 연동)
    function toggleTask(id) {
      const task = tasks.find(t => t.id === id);
      if (task) {
        task.completed = !task.completed;
        renderApp();
      }
    }

    // 2. 필터 변경
    function setFilter(filterType) {
      currentFilter = filterType;
      renderApp();
    }

    // 3. 바텀시트 제어 (열기/닫기)
    function openBottomSheet() {
      const container = document.getElementById('bottomSheetContainer');
      const backdrop = document.getElementById('bottomSheetBackdrop');
      const panel = document.getElementById('bottomSheetPanel');
      
      container.classList.remove('invisible');
      setTimeout(() => {
        backdrop.classList.remove('opacity-0');
        backdrop.classList.add('opacity-100');
        panel.classList.remove('translate-y-full');
        panel.classList.add('translate-y-0');
      }, 10);
      document.getElementById('taskTitleInput').focus();
    }

    function closeBottomSheet() {
      const container = document.getElementById('bottomSheetContainer');
      const backdrop = document.getElementById('bottomSheetBackdrop');
      const panel = document.getElementById('bottomSheetPanel');

      backdrop.classList.remove('opacity-100');
      backdrop.classList.add('opacity-0');
      panel.classList.remove('translate-y-0');
      panel.classList.add('translate-y-full');

      setTimeout(() => {
        container.classList.add('invisible');
      }, 280);
    }

    // 4. 새 태스크 생성 핸들러
    function handleCreateTask(e) {
      e.preventDefault();
      const title = document.getElementById('taskTitleInput').value.trim();
      if (!title) return;

      const priorityChecked = document.querySelector('input[name="priorityOption"]:checked');
      const priority = priorityChecked ? priorityChecked.value : 'medium';
      const tag = document.getElementById('taskTagSelect').value;
      const dueDate = document.getElementById('taskDueDateInput').value.trim() || '오늘';

      const newTask = {
        id: Date.now(),
        title: title,
        tag: tag,
        dueDate: dueDate,
        priority: priority,
        completed: false,
        starred: false
      };

      tasks.unshift(newTask);
      document.getElementById('newTaskForm').reset();
      document.getElementById('taskDueDateInput').value = '오늘 마감';
      closeBottomSheet();
      renderApp();
    }

    // 우선순위 뱃지 렌더러 (2단계 PriorityBadge 명세 재사용)
    function renderPriorityBadge(priority) {
      if (priority === 'high') {
        return `
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-semibold bg-[#FA5252]/10 text-destructive border border-[#FA5252]/20">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path>
              <line x1="4" y1="22" x2="4" y2="15"></line>
            </svg>
            <span>높음</span>
          </span>
        `;
      } else if (priority === 'medium') {
        return `
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-medium bg-background text-text-secondary border border-border">
            <span class="w-1.5 h-1.5 rounded-full bg-text-secondary"></span>
            <span>중간</span>
          </span>
        `;
      } else {
        return `
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-medium bg-primary-light text-primary border border-primary/20">
            <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
            <span>낮음</span>
          </span>
        `;
      }
    }

    // 메인 UI 렌더링 함수
    function renderApp() {
      // 통계 계산
      const totalCount = tasks.length;
      const completedCount = tasks.filter(t => t.completed).length;
      const inProgressCount = totalCount - completedCount;
      const starredCount = tasks.filter(t => t.starred).length;
      const percentage = totalCount === 0 ? 0 : Math.round((completedCount / totalCount) * 100);

      // 프로그레스 바 & 카운트 실시간 업데이트
      document.getElementById('progressPercentageText').textContent = `${percentage}%`;
      document.getElementById('progressStatsText').textContent = `${totalCount}개 중 ${completedCount}개 완료`;
      document.getElementById('progressBar').style.width = `${percentage}%`;

      // 칩 뱃지 카운트 업데이트
      document.getElementById('countBadge-ALL').textContent = totalCount;
      document.getElementById('countBadge-IN_PROGRESS').textContent = inProgressCount;
      document.getElementById('countBadge-COMPLETED').textContent = completedCount;
      document.getElementById('countBadge-STARRED').textContent = starredCount;

      // 필터 칩 스타일링 상태 토글
      const filterChips = document.querySelectorAll('.filter-chip');
      filterChips.forEach(chip => {
        const id = chip.id.replace('filter-', '');
        const badge = chip.querySelector('.filter-badge');
        if (id === currentFilter) {
          chip.className = 'filter-chip shrink-0 inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all active:scale-95 bg-primary text-white shadow-xs';
          if (badge) {
            badge.className = 'filter-badge px-1.5 py-0.2 rounded-full text-[11px] font-bold bg-white/20 text-white';
          }
        } else {
          chip.className = 'filter-chip shrink-0 inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-medium transition-all active:scale-95 bg-white border border-border text-text-primary hover:bg-background';
          if (badge) {
            badge.className = 'filter-badge px-1.5 py-0.2 rounded-full text-[11px] font-medium bg-background text-text-secondary';
          }
        }
      });

      // 태스크 필터링
      let filteredTasks = tasks;
      if (currentFilter === 'IN_PROGRESS') {
        filteredTasks = tasks.filter(t => !t.completed);
      } else if (currentFilter === 'COMPLETED') {
        filteredTasks = tasks.filter(t => t.completed);
      } else if (currentFilter === 'STARRED') {
        filteredTasks = tasks.filter(t => t.starred);
      }

      // 태스크 리스트 HTML 빌드 (TaskCard 컴포넌트 규격 그대로 적용)
      const listContainer = document.getElementById('taskListContainer');
      if (filteredTasks.length === 0) {
        listContainer.innerHTML = `
          <div class="h-48 flex flex-col items-center justify-center text-center p-6 bg-surface rounded-2xl border border-dashed border-border">
            <div class="w-10 h-10 rounded-full bg-background flex items-center justify-center text-text-muted mb-2">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            </div>
            <p class="text-sm font-medium text-text-secondary">해당하는 할 일이 없습니다</p>
            <p class="text-xs text-text-muted mt-0.5">우측 하단 (+) 버튼을 눌러 새 할 일을 등록해보세요</p>
          </div>
        `;
        return;
      }

      listContainer.innerHTML = filteredTasks.map(task => {
        const isDone = task.completed;
        return `
          <!-- TaskCard Item ID: ${task.id} (좌측 체크박스 | 중앙 컨텐츠 | 우측 메뉴) -->
          <article class="relative flex items-center gap-3 p-3.5 bg-surface rounded-2xl border ${isDone ? 'border-border/60 bg-surface/80' : 'border-border hover:border-primary/40'} shadow-card transition-all duration-200">
            
            <!-- 좌측 원형 체크박스 (터치 영역 확보 w-10 h-10) -->
            <button type="button" onclick="toggleTask(${task.id})" aria-label="${isDone ? '미완료로 변경' : '완료 처리'}" class="w-9 h-9 shrink-0 rounded-full flex items-center justify-center transition-all ${isDone ? 'bg-primary text-white' : 'border-2 border-text-muted/50 hover:border-primary'}">
              ${isDone ? `
                <svg class="w-4 h-4 stroke-[2.5] task-check-icon scale-100 opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              ` : `
                <div class="w-2 h-2 rounded-full bg-transparent"></div>
              `}
            </button>

            <!-- 중앙 메인 텍스트 및 메타 정보 (세로 오토레이아웃) -->
            <div class="flex-1 min-w-0" onclick="toggleTask(${task.id})">
              <!-- 상단: 우선순위 뱃지 및 카테고리 태그 -->
              <div class="flex items-center gap-1.5 mb-1">
                ${renderPriorityBadge(task.priority)}
                <span class="text-[11px] font-medium text-text-muted px-1.5 py-0.2 bg-background rounded">
                  ${task.tag}
                </span>
                ${task.starred ? `
                  <svg class="w-3 h-3 text-amber-500 fill-amber-500" viewBox="0 0 24 24" stroke="currentColor">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                  </svg>
                ` : ''}
              </div>

              <!-- 태스크 타이틀 (완료 시 취소선 및 muted 컬러 처리) -->
              <h3 class="task-title text-sm font-semibold tracking-tight truncate ${isDone ? 'line-through text-text-muted' : 'text-text-primary'}">
                ${task.title}
              </h3>

              <!-- 마감일 라벨 (캘린더 아이콘 + 텍스트) -->
              <div class="flex items-center gap-1 mt-1 text-[11px] ${isDone ? 'text-text-muted' : 'text-text-secondary'}">
                <svg class="w-3 h-3 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                <span>${task.dueDate}</span>
              </div>
            </div>

            <!-- 우측 더보기 메뉴 버튼 (3-dots vertical) -->
            <button type="button" aria-label="추가 옵션" class="w-8 h-8 shrink-0 flex items-center justify-center rounded-lg text-text-muted hover:text-text-primary hover:bg-background transition-colors">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="1"></circle>
                <circle cx="12" cy="5" r="1"></circle>
                <circle cx="12" cy="19" r="1"></circle>
              </svg>
            </button>

          </article>
        `;
      }).join('');
    }

    // 초기 렌더링 실행
    renderApp();
  </script>






