  function switchModalTab(tabKey) {
    const panes = {
      personality: document.getElementById('pane-personality'),
      stats: document.getElementById('pane-stats'),
      relations: document.getElementById('pane-relations')
    };

    const buttons = {
      personality: document.getElementById('tab-btn-personality'),
      stats: document.getElementById('tab-btn-stats'),
      relations: document.getElementById('tab-btn-relations')
    };

    // Active button class states
    const activeClasses = ['bg-primary-container', 'text-on-primary-container', 'shadow-[0_2px_8px_rgba(2,132,199,0.25)]'];
    const inactiveClasses = ['text-on-surface-variant', 'hover:text-on-surface', 'hover:bg-surface-container'];

    Object.keys(panes).forEach(key => {
      if (key === tabKey) {
        panes[key].classList.remove('hidden');
        panes[key].classList.add('flex');
        buttons[key].classList.remove(...inactiveClasses);
        buttons[key].classList.add(...activeClasses);
      } else {
        panes[key].classList.add('hidden');
        panes[key].classList.remove('flex');
        buttons[key].classList.remove(...activeClasses);
        buttons[key].classList.add(...inactiveClasses);
      }
    });
  }

  function triggerSaveAnimation() {
    const btn = document.getElementById('save-all-btn');
    const originalText = btn.innerHTML;
    btn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">refresh</span><span>반영 중...</span>';
    btn.disabled = true;
    setTimeout(() => {
      btn.innerHTML = '<span class="material-symbols-outlined text-[18px]">done_all</span><span>저장 완료!</span>';
      btn.classList.add('bg-secondary');
      setTimeout(() => {
        btn.innerHTML = originalText;
        btn.disabled = false;
        btn.classList.remove('bg-secondary');
      }, 1500);
    }, 600);
  }
